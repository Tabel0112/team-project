# AI generation: create a Gemini API key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional cloud accounts/storage: Supabase project settings > API.
# Run supabase/schema.sql in the project's SQL editor first.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional local JSON file path; blank uses ~/.study-app/study-sets.json.
STUDY_APP_DATA_FILE=
